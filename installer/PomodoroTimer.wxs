<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="{8C7B6A5D-4E3F-2A1B-9C8D-7E6F5A4B3C2D}" Name="Pomodoro Timer" Version="0.1.0.0" Manufacturer="Rajat Gade" Language="1033" Scope="perMachine">
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Pomodoro" />
      </Directory>
    </Directory>
    <Component Id="PomodoroExeComponent" Guid="{9B8A7C6D-5E4F-3A2B-8C1D-7E6F5A4B3C2D}">
      <File Id="PomodoroExeFile" Source="..\dist\PomodoroTimer.exe" KeyPath="yes" />
    </Component>
    <Component Id="PomodoroShortcutComponent" Guid="{8A9B7C6D-4E5F-3A2B-9C8D-7E6F5A4B3C2D}">
      <Shortcut Id="PomodoroShortcut" FileKey="PomodoroExeFile" Name="Pomodoro Timer" Target="FileKey" WorkingDirectory="INSTALLFOLDER" />
    </Component>
    <Property Id="RUNATLOGON" Value="0" />
    <Component Id="PomodoroRunKeyComponent" Guid="{7C8D9E0F-5A6B-4C7D-8E9F-0A1B2C3D4E5F}" Condition="RUNATLOGON = &quot;1&quot;">
      <RegistryKey Key="Software\Microsoft\Windows\CurrentVersion\Run">
        <RegistryValue Name="PomodoroTimer" Type="string" Value="&quot;C:\Program Files\Pomodoro\PomodoroTimer.exe&quot;" Root="HKCU" KeyPath="yes" />
      </RegistryKey>
    </Component>
  </Package>
</Wix>
