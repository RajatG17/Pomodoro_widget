<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Pomodoro Timer"
           Manufacturer="Rajat Gade"
           Version="0.1.0.0"
           UpgradeCode="{8C7B6A5D-4E3F-2A1B-9C8D-7E6F5A4B3C2D}"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="RUNATLOGON" Value="0" Secure="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)LICENSE.rtf" />

    <ui:WixUI Id="WixUI_Minimal" />

    <UI Id="PomodoroOptionsUI">
      <Dialog Id="PomodoroOptionsDlg" Width="370" Height="270" Title="Pomodoro Timer Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="Installation Options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="Choose how Pomodoro Timer should start." />
        <Control Id="RunAtLogonCheckBox" Type="CheckBox" X="20" Y="80" Width="330" Height="17"
                 Property="RUNATLOGON" CheckBoxValue="1"
                 Text="Start Pomodoro Timer automatically when I log on to Windows" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Disabled="yes" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel" />
      </Dialog>

      <Publish Dialog="PomodoroOptionsDlg" Control="Next" Event="NewDialog" Value="WelcomeEulaDlg" Order="1" />
      <Publish Dialog="PomodoroOptionsDlg" Control="Cancel" Event="SpawnDialog" Value="CancelDlg" Order="1" />

      <InstallUISequence>
        <Show Dialog="PomodoroOptionsDlg" Before="WelcomeEulaDlg" Condition="NOT Installed" />
      </InstallUISequence>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Pomodoro" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Pomodoro Timer">
        <Component Id="PomodoroShortcutComponent" Guid="{8A9B7C6D-4E5F-3A2B-9C8D-7E6F5A4B3C2D}">
          <Shortcut Id="PomodoroShortcut"
                    Name="Pomodoro Timer"
                    Target="[INSTALLFOLDER]PomodoroTimer.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\Rajat Gade\Pomodoro Timer"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Component Id="PomodoroExeComponent" Guid="{9B8A7C6D-5E4F-3A2B-8C1D-7E6F5A4B3C2D}"
               Directory="INSTALLFOLDER">
      <File Id="PomodoroExeFile" Source="$(sys.SOURCEFILEDIR)..\dist\PomodoroTimer.exe" KeyPath="yes" />
    </Component>

    <Component Id="PomodoroRunKeyComponent" Guid="{7C8D9E0F-5A6B-4C7D-8E9F-0A1B2C3D4E5F}"
               Directory="INSTALLFOLDER"
               Condition="RUNATLOGON = 1">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="PomodoroTimer"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]PomodoroTimer.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="Pomodoro Timer" Level="1">
      <ComponentRef Id="PomodoroExeComponent" />
      <ComponentRef Id="PomodoroShortcutComponent" />
      <ComponentRef Id="PomodoroRunKeyComponent" />
    </Feature>
  </Package>
</Wix>
